<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.felix</groupId>
        <artifactId>dependencymanager-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>org.apache.felix.dependencymanager.benchmark</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Apache Felix Dependency Manager Benchmark</name>
    <description>Benchmark of Apache Felix Dependency Manager</description>

    <properties>
        <!-- the samples are not released -->
        <baseline.skip>true</baseline.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.cmpn</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.felix</groupId>
            <artifactId>org.apache.felix.dependencymanager</artifactId>
            <version>${dependencymanager.version}</version>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src</sourceDirectory>
        <plugins>
            <plugin>
                <!-- there is no main artifact to verify, the sample bundles are attached with a classifier -->
                <groupId>org.apache.geronimo.genesis.plugins</groupId>
                <artifactId>tools-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>verify-legal-files</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- only the bundles built below are needed, the default jar would contain all the classes of the module -->
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <instructions>
                    </instructions>
                </configuration>
                <executions>
                    <execution>
                        <id>controller</id>
                        <phase>package</phase>
                        <goals>
                            <goal>bundle</goal>
                        </goals>
                        <configuration>
                            <classifier>controller</classifier>
                            <instructions>
                                <Bundle-SymbolicName>org.apache.felix.dependencymanager.benchmark.controller</Bundle-SymbolicName>
                                <Include-Resource>META-INF/DEPENDENCIES=${project.build.directory}/maven-shared-archive-resources/META-INF/DEPENDENCIES,META-INF/LICENSE=${project.build.directory}/maven-shared-archive-resources/META-INF/LICENSE,META-INF/NOTICE=${project.build.directory}/maven-shared-archive-resources/META-INF/NOTICE,org/apache/felix/dm/benchmark/controller=${project.build.outputDirectory}/org/apache/felix/dm/benchmark/controller,org/apache/felix/dm/benchmark/controller/impl=${project.build.outputDirectory}/org/apache/felix/dm/benchmark/controller/impl</Include-Resource>
                                <Private-Package />
                                <Export-Package>org.apache.felix.dm.benchmark.controller</Export-Package>
                                <Bundle-Activator>org.apache.felix.dm.benchmark.controller.impl.Activator</Bundle-Activator>
                            </instructions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>dependencymanager</id>
                        <phase>package</phase>
                        <goals>
                            <goal>bundle</goal>
                        </goals>
                        <configuration>
                            <classifier>dependencymanager</classifier>
                            <instructions>
                                <Bundle-SymbolicName>org.apache.felix.dependencymanager.benchmark.dependencymanager</Bundle-SymbolicName>
                                <Include-Resource>META-INF/DEPENDENCIES=${project.build.directory}/maven-shared-archive-resources/META-INF/DEPENDENCIES,META-INF/LICENSE=${project.build.directory}/maven-shared-archive-resources/META-INF/LICENSE,META-INF/NOTICE=${project.build.directory}/maven-shared-archive-resources/META-INF/NOTICE,org/apache/felix/dm/benchmark/dependencymanager=${project.build.outputDirectory}/org/apache/felix/dm/benchmark/dependencymanager,org/apache/felix/dm/benchmark/scenario/impl=${project.build.outputDirectory}/org/apache/felix/dm/benchmark/scenario/impl</Include-Resource>
                                <Private-Package />
                                <Export-Package>org.apache.felix.dm.benchmark.scenario.impl</Export-Package>
                                <Bundle-Activator>org.apache.felix.dm.benchmark.dependencymanager.Activator</Bundle-Activator>
                            </instructions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>dependencymanager.parallel</id>
                        <phase>package</phase>
                        <goals>
                            <goal>bundle</goal>
                        </goals>
                        <configuration>
                            <classifier>dependencymanager.parallel</classifier>
                            <instructions>
                                <Bundle-SymbolicName>org.apache.felix.dependencymanager.benchmark.dependencymanager.parallel</Bundle-SymbolicName>
                                <Include-Resource>META-INF/DEPENDENCIES=${project.build.directory}/maven-shared-archive-resources/META-INF/DEPENDENCIES,META-INF/LICENSE=${project.build.directory}/maven-shared-archive-resources/META-INF/LICENSE,META-INF/NOTICE=${project.build.directory}/maven-shared-archive-resources/META-INF/NOTICE,org/apache/felix/dm/benchmark/dependencymanager=${project.build.outputDirectory}/org/apache/felix/dm/benchmark/dependencymanager,org/apache/felix/dm/benchmark/scenario/impl=${project.build.outputDirectory}/org/apache/felix/dm/benchmark/scenario/impl</Include-Resource>
                                <Private-Package />
                                <Export-Package>org.apache.felix.dm.benchmark.scenario.impl</Export-Package>
                                <Bundle-Activator>org.apache.felix.dm.benchmark.dependencymanager.ParallelActivator</Bundle-Activator>
                            </instructions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>scenario</id>
                        <phase>package</phase>
                        <goals>
                            <goal>bundle</goal>
                        </goals>
                        <configuration>
                            <classifier>scenario</classifier>
                            <instructions>
                                <Bundle-SymbolicName>org.apache.felix.dependencymanager.benchmark.scenario</Bundle-SymbolicName>
                                <Include-Resource>META-INF/DEPENDENCIES=${project.build.directory}/maven-shared-archive-resources/META-INF/DEPENDENCIES,META-INF/LICENSE=${project.build.directory}/maven-shared-archive-resources/META-INF/LICENSE,META-INF/NOTICE=${project.build.directory}/maven-shared-archive-resources/META-INF/NOTICE,org/apache/felix/dm/benchmark/scenario=${project.build.outputDirectory}/org/apache/felix/dm/benchmark/scenario,org/apache/felix/dm/benchmark/scenario/impl=${project.build.outputDirectory}/org/apache/felix/dm/benchmark/scenario/impl</Include-Resource>
                                <Private-Package />
                                <Export-Package>org.apache.felix.dm.benchmark.scenario.impl,org.apache.felix.dm.benchmark.scenario</Export-Package>
                            </instructions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
