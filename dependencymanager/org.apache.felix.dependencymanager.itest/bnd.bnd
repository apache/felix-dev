-runbundles: \
	org.apache.servicemix.bundles.junit;version=4.13.2,\
	org.mockito.mockito-core;version='[5.24.0,5.25)',\
	net.bytebuddy.byte-buddy;version='[1.17.7,1.18)',\
	net.bytebuddy.byte-buddy-agent;version='[1.17.7,1.18)',\
	org.objenesis;version='[3.3.0,3.3.1)',\
	org.apache.felix.metatype;version=1.2.4,\
	org.apache.felix.log;version=1.3.2,\
	org.apache.felix.configadmin;version=latest,\
	org.apache.felix.dependencymanager;version=latest,\
	org.apache.felix.dependencymanager.shell;version=latest,\
	org.apache.felix.gogo.runtime;version=latest,\
	org.apache.felix.gogo.shell,\
	org.apache.felix.gogo.command
-runee: JavaSE-11
-runvm: -ea
-runfw: org.apache.felix.framework;version='[8.0.0,9)'
-buildpath: \
	osgi.core;version=8.0,\
	osgi.cmpn;version=7.0,\
	org.apache.felix.dependencymanager;version=latest,\
	org.apache.felix.dependencymanager.shell;version=latest,\
	${junit},\
	org.apache.felix.gogo.runtime;version=latest
-runsystempackages: \
	sun.reflect
-sub:  \
	*.bnd
Test-Cases:  \
	${classes;CONCRETE;EXTENDS;junit.framework.TestCase}
-runproperties:  \
	org.apache.felix.dependencymanager.loglevel=2,\
	org.apache.felix.log.maxSize=100000,\
	org.apache.felix.log.storeDebug=true,\
	gosh.args=--noshutdown
	
# we do not release this project in binary distribution.
-releaserepo: 
-baseline: 
