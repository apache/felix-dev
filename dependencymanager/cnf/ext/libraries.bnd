##
# metatype service
metatype=org.apache.felix.metatype;version=1.2.4

##
# log service
log=org.apache.felix.log;version=1.3.2

##
# Gogo bundles
gogo=\
	org.apache.felix.gogo.command;version=latest,\
	org.apache.felix.gogo.runtime;version=latest,\
	org.apache.felix.gogo.shell;version=latest,\
	org.jline;version=3.29.0,\
	org.fusesource.jansi;version=1.16.0

 
##
# Configuration Admin
configadmin=org.apache.felix.configadmin;version=latest

##
# Event Admin
eventadmin=org.apache.felix.eventadmin;version=1.4.4

##
# Web Console
webconsole=\
	org.apache.felix.http.api;version=3.0.0,\
	org.apache.felix.http.servlet-api;version=1.1.2,\
	org.apache.felix.http.jetty;version="[3.4.8,3.4.9]",\
	org.apache.felix.webconsole;version=4.3.4,\
	org.apache.commons.fileupload;version=1.2.1,\
	org.apache.commons.io;version=2.4.0
		
##
# bndlib 
bndlib=biz.aQute.bndlib;version=7.4.0

##
# mockito
mockito=\
	org.mockito.mockito-core;version=5.24.0,\
	net.bytebuddy.byte-buddy;version=1.17.7,\
	net.bytebuddy.byte-buddy-agent;version=1.17.7

## 
# objenesis
objenesis=org.objenesis;version=3.3

##
# runtime dependencies used by integration tests
#
itest.run=\
	org.apache.servicemix.bundles.junit;version=4.13.2,\
	org.mockito.mockito-core;version='[5.24.0,5.25)',\
	net.bytebuddy.byte-buddy;version='[1.17.7,1.18)',\
	net.bytebuddy.byte-buddy-agent;version='[1.17.7,1.18)',\
	org.objenesis;version='[3.3.0,3.3.1)'	

##
# Felix Framework
#
felix.framework=org.apache.felix.framework;version='[8.0.0,9)'
