<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.apache.felix</groupId>
        <artifactId>dependencymanager-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>org.apache.felix.dependencymanager.lambda.samples</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Apache Felix Dependency Manager Lambda Samples</name>
    <description>Samples of the Apache Felix Dependency Manager lambda API</description>

    <properties>
        <!-- the samples are not released -->
        <baseline.skip>true</baseline.skip>
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.install.skip>true</maven.install.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.cmpn</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.felix</groupId>
            <artifactId>org.apache.felix.dependencymanager</artifactId>
            <version>${dependencymanager.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.felix</groupId>
            <artifactId>org.apache.felix.dependencymanager.lambda</artifactId>
            <version>${dependencymanager.lambda.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.felix</groupId>
            <artifactId>org.apache.felix.gogo.runtime</artifactId>
            <version>${gogo.runtime.version}</version>
                    <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src</sourceDirectory>
        <plugins>
            <plugin>
                <!-- there is no main artifact to verify, the sample bundles are attached with a classifier -->
                <groupId>org.apache.geronimo.genesis.plugins</groupId>
                <artifactId>tools-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>verify-legal-files</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- only the bundles built below are needed, the default jar would contain all the classes of the module -->
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <phase>none</phase>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.felix</groupId>
                <artifactId>maven-bundle-plugin</artifactId>
                <configuration>
                    <instructions>
                    </instructions>
                </configuration>
                <executions>
                    <execution>
                        <id>compositefactory</id>
                        <phase>package</phase>
                        <goals>
                            <goal>bundle</goal>
                        </goals>
                        <configuration>
                            <classifier>compositefactory</classifier>
                            <instructions>
                                <Bundle-SymbolicName>org.apache.felix.dependencymanager.lambda.samples.compositefactory</Bundle-SymbolicName>
                                <Include-Resource>META-INF/DEPENDENCIES=${project.build.directory}/maven-shared-archive-resources/META-INF/DEPENDENCIES,META-INF/LICENSE=${project.build.directory}/maven-shared-archive-resources/META-INF/LICENSE,META-INF/NOTICE=${project.build.directory}/maven-shared-archive-resources/META-INF/NOTICE,org/apache/felix/dm/lambda/samples/compositefactory=${project.build.outputDirectory}/org/apache/felix/dm/lambda/samples/compositefactory</Include-Resource>
                                <Private-Package />
                                <Export-Package />
                                <Bundle-License>http://www.apache.org/licenses/LICENSE-2.0.txt</Bundle-License>
                                <Bundle-DocURL>http://felix.apache.org/documentation/subprojects/apache-felix-dependency-manager.html</Bundle-DocURL>
                                <Bundle-Vendor>The Apache Software Foundation</Bundle-Vendor>
                                <Bundle-Activator>org.apache.felix.dm.lambda.samples.compositefactory.Activator</Bundle-Activator>
                            </instructions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>device</id>
                        <phase>package</phase>
                        <goals>
                            <goal>bundle</goal>
                        </goals>
                        <configuration>
                            <classifier>device</classifier>
                            <instructions>
                                <Bundle-SymbolicName>org.apache.felix.dependencymanager.lambda.samples.device</Bundle-SymbolicName>
                                <Include-Resource>META-INF/DEPENDENCIES=${project.build.directory}/maven-shared-archive-resources/META-INF/DEPENDENCIES,META-INF/LICENSE=${project.build.directory}/maven-shared-archive-resources/META-INF/LICENSE,META-INF/NOTICE=${project.build.directory}/maven-shared-archive-resources/META-INF/NOTICE,org/apache/felix/dm/lambda/samples/device=${project.build.outputDirectory}/org/apache/felix/dm/lambda/samples/device</Include-Resource>
                                <Private-Package />
                                <Export-Package />
                                <Bundle-License>http://www.apache.org/licenses/LICENSE-2.0.txt</Bundle-License>
                                <Bundle-DocURL>http://felix.apache.org/documentation/subprojects/apache-felix-dependency-manager.html</Bundle-DocURL>
                                <Bundle-Vendor>The Apache Software Foundation</Bundle-Vendor>
                                <Bundle-Activator>org.apache.felix.dm.lambda.samples.device.Activator</Bundle-Activator>
                            </instructions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>dictionary</id>
                        <phase>package</phase>
                        <goals>
                            <goal>bundle</goal>
                        </goals>
                        <configuration>
                            <classifier>dictionary</classifier>
                            <instructions>
                                <Bundle-SymbolicName>org.apache.felix.dependencymanager.lambda.samples.dictionary</Bundle-SymbolicName>
                                <Include-Resource>META-INF/DEPENDENCIES=${project.build.directory}/maven-shared-archive-resources/META-INF/DEPENDENCIES,META-INF/LICENSE=${project.build.directory}/maven-shared-archive-resources/META-INF/LICENSE,META-INF/NOTICE=${project.build.directory}/maven-shared-archive-resources/META-INF/NOTICE,org/apache/felix/dm/lambda/samples/dictionary=${project.build.outputDirectory}/org/apache/felix/dm/lambda/samples/dictionary</Include-Resource>
                                <Private-Package />
                                <Export-Package />
                                <Bundle-License>http://www.apache.org/licenses/LICENSE-2.0.txt</Bundle-License>
                                <Bundle-DocURL>http://felix.apache.org/documentation/subprojects/apache-felix-dependency-manager.html</Bundle-DocURL>
                                <Bundle-Vendor>The Apache Software Foundation</Bundle-Vendor>
                                <Bundle-Activator>org.apache.felix.dm.lambda.samples.dictionary.Activator</Bundle-Activator>
                            </instructions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>factory</id>
                        <phase>package</phase>
                        <goals>
                            <goal>bundle</goal>
                        </goals>
                        <configuration>
                            <classifier>factory</classifier>
                            <instructions>
                                <Bundle-SymbolicName>org.apache.felix.dependencymanager.lambda.samples.factory</Bundle-SymbolicName>
                                <Include-Resource>META-INF/DEPENDENCIES=${project.build.directory}/maven-shared-archive-resources/META-INF/DEPENDENCIES,META-INF/LICENSE=${project.build.directory}/maven-shared-archive-resources/META-INF/LICENSE,META-INF/NOTICE=${project.build.directory}/maven-shared-archive-resources/META-INF/NOTICE,org/apache/felix/dm/lambda/samples/factory=${project.build.outputDirectory}/org/apache/felix/dm/lambda/samples/factory</Include-Resource>
                                <Private-Package />
                                <Export-Package />
                                <Bundle-License>http://www.apache.org/licenses/LICENSE-2.0.txt</Bundle-License>
                                <Bundle-DocURL>http://felix.apache.org/documentation/subprojects/apache-felix-dependency-manager.html</Bundle-DocURL>
                                <Bundle-Vendor>The Apache Software Foundation</Bundle-Vendor>
                                <Bundle-Activator>org.apache.felix.dm.lambda.samples.factory.Activator</Bundle-Activator>
                            </instructions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>future</id>
                        <phase>package</phase>
                        <goals>
                            <goal>bundle</goal>
                        </goals>
                        <configuration>
                            <classifier>future</classifier>
                            <instructions>
                                <Bundle-SymbolicName>org.apache.felix.dependencymanager.lambda.samples.future</Bundle-SymbolicName>
                                <Include-Resource>META-INF/DEPENDENCIES=${project.build.directory}/maven-shared-archive-resources/META-INF/DEPENDENCIES,META-INF/LICENSE=${project.build.directory}/maven-shared-archive-resources/META-INF/LICENSE,META-INF/NOTICE=${project.build.directory}/maven-shared-archive-resources/META-INF/NOTICE,org/apache/felix/dm/lambda/samples/future=${project.build.outputDirectory}/org/apache/felix/dm/lambda/samples/future</Include-Resource>
                                <Private-Package />
                                <Export-Package />
                                <Bundle-License>http://www.apache.org/licenses/LICENSE-2.0.txt</Bundle-License>
                                <Bundle-DocURL>http://felix.apache.org/documentation/subprojects/apache-felix-dependency-manager.html</Bundle-DocURL>
                                <Bundle-Vendor>The Apache Software Foundation</Bundle-Vendor>
                                <Bundle-Activator>org.apache.felix.dm.lambda.samples.future.Activator</Bundle-Activator>
                            </instructions>
                        </configuration>
                    </execution>
                    <execution>
                        <id>hello</id>
                        <phase>package</phase>
                        <goals>
                            <goal>bundle</goal>
                        </goals>
                        <configuration>
                            <classifier>hello</classifier>
                            <instructions>
                                <Bundle-SymbolicName>org.apache.felix.dependencymanager.lambda.samples.hello</Bundle-SymbolicName>
                                <Include-Resource>META-INF/DEPENDENCIES=${project.build.directory}/maven-shared-archive-resources/META-INF/DEPENDENCIES,META-INF/LICENSE=${project.build.directory}/maven-shared-archive-resources/META-INF/LICENSE,META-INF/NOTICE=${project.build.directory}/maven-shared-archive-resources/META-INF/NOTICE,org/apache/felix/dm/lambda/samples/hello=${project.build.outputDirectory}/org/apache/felix/dm/lambda/samples/hello</Include-Resource>
                                <Private-Package />
                                <Export-Package />
                                <Bundle-License>http://www.apache.org/licenses/LICENSE-2.0.txt</Bundle-License>
                                <Bundle-DocURL>http://felix.apache.org/documentation/subprojects/apache-felix-dependency-manager.html</Bundle-DocURL>
                                <Bundle-Vendor>The Apache Software Foundation</Bundle-Vendor>
                                <Bundle-Activator>org.apache.felix.dm.lambda.samples.hello.Activator</Bundle-Activator>
                            </instructions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
